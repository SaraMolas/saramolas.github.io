source "https://rubygems.org"

# Same Jekyll version + plugins that GitHub Pages uses to build the live site.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Standard libraries that newer Rubies (3.4+/4.0) no longer bundle,
# but which GitHub Pages' Jekyll 3.x still loads.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
